DATABASE_URL="postgresql://user:password@host:port/database"
JWT_SECRET="replace-with-a-secure-secret"
# Public web origin, required in production (HTTPS).
APP_ENV="development"
# Password-only login for now. Set true to require TOTP for platform owners.
AUTH_REQUIRE_PLATFORM_MFA="false"
# embedded runs local background tasks with the API; external uses go run ./cmd/worker.
WORKER_MODE="embedded"
PUBLIC_SITE_URL="http://127.0.0.1:5173"
# Optional dedicated key for encrypted MFA seeds and mail bodies. Keep it stable.
# When empty, a domain-separated key is derived from JWT_SECRET.
AUTH_ENCRYPTION_KEY=""
# Transactional recovery/invitation email (TLS required: STARTTLS 587 or TLS 465).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_FROM=""
SMTP_USERNAME=""
SMTP_PASSWORD=""

# Mercado Pago: disabled until this app's own credentials and HTTPS origin are configured.
MP_ENABLED="false"
MP_LIVE_ENABLED="false"
MP_ENVIRONMENT="sandbox"
MP_PUBLIC_ORIGIN=""
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_PLATFORM_ACCESS_TOKEN=""
MP_PLATFORM_COLLECTOR_ID=""
MP_WEBHOOK_SECRET=""
# Base64-encoded 32 random bytes. Keep stable and private; never reuse Al Toque keys.
MP_ENCRYPTION_KEY_ID="v1"
MP_ENCRYPTION_KEY=""
# Optional JSON key ring, e.g. {"v1":"base64-key","v2":"base64-key"}.
MP_ENCRYPTION_KEYS=""
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_STORAGE_BUCKET="catalog_images"

# Optional stable dedicated secret (32+ bytes); otherwise AUTH_ENCRYPTION_KEY/JWT_SECRET is used.
# Back it up privately and keep the same key in the API and external worker.
BACKUP_ENCRYPTION_KEY=""
# Optional server-only monitoring relay; never exposed through VITE_*.
SENTRY_DSN=""
# Optional mailbox notified of new support tickets through the encrypted SMTP outbox.
SUPPORT_EMAIL=""

# Only needed to create the first platform administrator with go run ./cmd/seed.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_FIRST_NAME=""
SEED_OWNER_LAST_NAME=""

# Optional dedicated PostgreSQL session URL for SSE LISTEN (not a transaction pool).
# Defaults to DATABASE_URL; Supabase pooler port 6543 maps to session port 5432.
SSE_DATABASE_URL=""

# Checkout verification: create a managed Turnstile widget for PUBLIC_SITE_URL.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Optional stable HMAC key for abuse subjects; defaults to JWT_SECRET.
ABUSE_HASH_KEY=""
