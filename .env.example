DATABASE_URL="postgresql://user:password@host:port/database"
JWT_SECRET="replace-with-a-secure-secret"
# Public web origin, required in production (HTTPS).
APP_ENV="development"
PUBLIC_SITE_URL="http://127.0.0.1:5173"
# Optional dedicated key for encrypted MFA seeds and mail bodies. Keep it stable.
# When empty, a domain-separated key is derived from JWT_SECRET.
AUTH_ENCRYPTION_KEY=""
# Transactional recovery/invitation email (TLS required: STARTTLS 587 or TLS 465).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_FROM=""
SMTP_USERNAME=""
SMTP_PASSWORD=""
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="replace-with-your-service-role-key"
SUPABASE_STORAGE_BUCKET="catalog_images"

# Only needed to create the first platform administrator with go run ./cmd/seed.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
SEED_OWNER_FIRST_NAME=""
SEED_OWNER_LAST_NAME=""
