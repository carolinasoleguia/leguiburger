-- 1. EXTENSIONES Y LIMPIEZA
CREATE EXTENSION IF NOT EXISTS "pgcrypto";

DROP TABLE IF EXISTS sales CASCADE;
DROP TABLE IF EXISTS order_detail_extras CASCADE;
DROP TABLE IF EXISTS order_details CASCADE;
DROP TABLE IF EXISTS orders CASCADE;
DROP TABLE IF EXISTS shipping_methods CASCADE;
DROP TABLE IF EXISTS promotions CASCADE;
DROP TABLE IF EXISTS recipes CASCADE;
DROP TABLE IF EXISTS supply_cost_history CASCADE;
DROP TABLE IF EXISTS supplies CASCADE;
DROP TABLE IF EXISTS extras CASCADE;
DROP TABLE IF EXISTS price_history CASCADE;
DROP TABLE IF EXISTS products CASCADE;
DROP TABLE IF EXISTS customers CASCADE;
DROP TABLE IF EXISTS employees CASCADE;
DROP TABLE IF EXISTS tenants CASCADE;
DROP TABLE IF EXISTS users CASCADE;
DROP TABLE IF EXISTS brands CASCADE;
DROP TABLE IF EXISTS order_statuses_lookup CASCADE;
DROP TABLE IF EXISTS payment_statuses_lookup CASCADE;

-- 2. TABLAS LOOKUP
CREATE TABLE order_statuses_lookup (
    id INT2 PRIMARY KEY,
    code VARCHAR NOT NULL UNIQUE,
    name VARCHAR NOT NULL,
    description VARCHAR
);

CREATE TABLE payment_statuses_lookup (
    id INT2 PRIMARY KEY,
    code VARCHAR NOT NULL UNIQUE,
    name VARCHAR NOT NULL,
    description VARCHAR
);

-- 3. BRANDS & USERS (Sincronizado con Supabase)
CREATE TABLE brands (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    name VARCHAR NOT NULL,
    tax_id VARCHAR UNIQUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE users (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    email VARCHAR NOT NULL UNIQUE,
    password_hash VARCHAR NOT NULL,
    role VARCHAR NOT NULL,
    brand_id UUID REFERENCES brands(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ DEFAULT NOW(),
    updated_at TIMESTAMPTZ DEFAULT NOW(),
    is_active BOOL DEFAULT TRUE,
    first_name VARCHAR,
    last_name VARCHAR
);

-- 4. TENANTS (Con brand_id y sin name/tax_id, según Supabase)
CREATE TABLE tenants (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    subdomain VARCHAR NOT NULL,
    active BOOL NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    brand_id UUID REFERENCES brands(id) ON DELETE CASCADE
);

-- 5. EMPLOYEES & CUSTOMERS
CREATE TABLE employees (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID REFERENCES tenants(id) ON DELETE CASCADE,
    first_name VARCHAR NOT NULL,
    last_name VARCHAR NOT NULL,
    email VARCHAR NOT NULL UNIQUE,
    password_hash VARCHAR NOT NULL,
    phone VARCHAR,
    role VARCHAR NOT NULL,
    is_active BOOL NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW()
);

CREATE TABLE customers (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    first_name VARCHAR NOT NULL,
    last_name VARCHAR NOT NULL,
    email VARCHAR NOT NULL,
    phone VARCHAR,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT unique_tenant_customer_email UNIQUE (tenant_id, email)
);

-- 6. PRODUCTOS, EXTRAS Y INSUMOS
CREATE TABLE products (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR NOT NULL,
    description TEXT,
    current_price NUMERIC NOT NULL CHECK (current_price >= 0),
    current_stock INT4 NOT NULL DEFAULT 0 CHECK (current_stock >= 0),
    track_stock BOOL NOT NULL DEFAULT TRUE,
    image_url VARCHAR,
    is_active BOOL NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT unique_tenant_product_name UNIQUE (tenant_id, name)
);

CREATE TABLE extras (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR NOT NULL,
    current_price NUMERIC NOT NULL CHECK (current_price >= 0),
    current_stock INT4 NOT NULL DEFAULT 0 CHECK (current_stock >= 0),
    track_stock BOOL NOT NULL DEFAULT TRUE,
    is_active BOOL NOT NULL DEFAULT TRUE,
    CONSTRAINT unique_tenant_extra_name UNIQUE (tenant_id, name)
);

CREATE TABLE supplies (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR NOT NULL,
    current_wholesale_cost NUMERIC NOT NULL CHECK (current_wholesale_cost >= 0),
    current_stock NUMERIC NOT NULL DEFAULT 0 CHECK (current_stock >= 0),
    measurement_unit VARCHAR NOT NULL,
    is_active BOOL NOT NULL DEFAULT TRUE,
    CONSTRAINT unique_tenant_supply_name UNIQUE (tenant_id, name)
);

-- 7. HISTORIALES Y RECETAS
CREATE TABLE price_history (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    product_id UUID NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    price NUMERIC NOT NULL CHECK (price >= 0),
    start_date TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    end_date TIMESTAMPTZ,
    created_by UUID REFERENCES employees(id) ON DELETE SET NULL
);

CREATE TABLE supply_cost_history (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    supply_id UUID NOT NULL REFERENCES supplies(id) ON DELETE CASCADE,
    wholesale_cost NUMERIC NOT NULL CHECK (wholesale_cost >= 0),
    start_date TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    end_date TIMESTAMPTZ,
    created_by UUID REFERENCES employees(id) ON DELETE SET NULL
);

CREATE TABLE recipes (
    product_id UUID REFERENCES products(id) ON DELETE CASCADE,
    supply_id UUID REFERENCES supplies(id) ON DELETE CASCADE,
    quantity_used NUMERIC NOT NULL CHECK (quantity_used > 0),
    PRIMARY KEY (product_id, supply_id)
);

CREATE TABLE promotions (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR NOT NULL,
    product_id UUID NOT NULL REFERENCES products(id) ON DELETE CASCADE,
    discount_type VARCHAR NOT NULL,
    value NUMERIC NOT NULL CHECK (value >= 0),
    start_date TIMESTAMPTZ NOT NULL,
    end_date TIMESTAMPTZ NOT NULL,
    is_active BOOL NOT NULL DEFAULT TRUE,
    promo_stock INT4 CHECK (promo_stock IS NULL OR promo_stock >= 0),
    promo_stock_used INT4 NOT NULL DEFAULT 0 CHECK (promo_stock_used >= 0),
    CONSTRAINT chk_promo_dates CHECK (end_date > start_date)
);

CREATE TABLE shipping_methods (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    name VARCHAR NOT NULL,
    cost NUMERIC NOT NULL DEFAULT 0 CHECK (cost >= 0),
    estimated_time VARCHAR,
    is_active BOOL NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    description VARCHAR,
    typification VARCHAR
);

-- 8. ÓRDENES Y TRANSACCIONES
CREATE TABLE orders (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    customer_id UUID REFERENCES customers(id) ON DELETE SET NULL,
    shipping_method_id UUID REFERENCES shipping_methods(id) ON DELETE SET NULL,
    order_status_id INT2 NOT NULL REFERENCES order_statuses_lookup(id),
    payment_status_id INT2 NOT NULL REFERENCES payment_statuses_lookup(id),
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    shipping_cost NUMERIC NOT NULL DEFAULT 0 CHECK (shipping_cost >= 0),
    shipping_address TEXT,
    subtotal NUMERIC NOT NULL DEFAULT 0 CHECK (subtotal >= 0),
    total_discounts NUMERIC NOT NULL DEFAULT 0 CHECK (total_discounts >= 0),
    total_paid NUMERIC NOT NULL DEFAULT 0 CHECK (total_paid >= 0)
);

CREATE TABLE order_details (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_id UUID NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    product_id UUID REFERENCES products(id) ON DELETE SET NULL,
    quantity INT4 NOT NULL CHECK (quantity > 0),
    list_price_unit NUMERIC NOT NULL CHECK (list_price_unit >= 0),
    promotion_id UUID REFERENCES promotions(id) ON DELETE SET NULL,
    discount_unit NUMERIC NOT NULL DEFAULT 0 CHECK (discount_unit >= 0),
    final_price_unit NUMERIC NOT NULL CHECK (final_price_unit >= 0)
);

CREATE TABLE order_detail_extras (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    order_detail_id UUID NOT NULL REFERENCES order_details(id) ON DELETE CASCADE,
    extra_id UUID REFERENCES extras(id) ON DELETE SET NULL,
    extra_name VARCHAR NOT NULL,
    extra_price_charged NUMERIC NOT NULL CHECK (extra_price_charged >= 0)
);

CREATE TABLE sales (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    order_id UUID NOT NULL REFERENCES orders(id) ON DELETE CASCADE,
    customer_id UUID REFERENCES customers(id) ON DELETE SET NULL,
    shipping_method_id UUID REFERENCES shipping_methods(id) ON DELETE SET NULL,
    payment_status_id INT2 REFERENCES payment_statuses_lookup(id),
    sale_date TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    product_id UUID NOT NULL REFERENCES products(id),
    product_name VARCHAR NOT NULL,
    quantity INT4 NOT NULL CHECK (quantity > 0),
    frozen_cost_unit NUMERIC NOT NULL,
    total_list_price NUMERIC NOT NULL,
    total_discount_applied NUMERIC NOT NULL DEFAULT 0,
    total_extras_amount NUMERIC NOT NULL DEFAULT 0,
    total_shipping_amount NUMERIC NOT NULL DEFAULT 0,
    total_net_revenue NUMERIC NOT NULL
);

CREATE TABLE production_reports (
    id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    tenant_id UUID NOT NULL REFERENCES tenants(id) ON DELETE CASCADE,
    production_date DATE NOT NULL,
    medallions_produced INT NOT NULL DEFAULT 0 CHECK (medallions_produced >= 0),
    breads_purchased INT NOT NULL DEFAULT 0 CHECK (breads_purchased >= 0),
    notes TEXT,
    created_by UUID REFERENCES employees(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
    CONSTRAINT unique_tenant_production_date UNIQUE (tenant_id, production_date)
);

-- 9. ÍNDICES DE RENDIMIENTO (Multi-tenant & Dashboards)
CREATE INDEX idx_customers_tenant ON customers(tenant_id);
CREATE INDEX idx_products_tenant ON products(tenant_id);
CREATE INDEX idx_orders_tenant_status_date ON orders(tenant_id, order_status_id, created_at DESC);
CREATE INDEX idx_sales_tenant_date ON sales(tenant_id, sale_date DESC);
CREATE INDEX idx_supplies_low_stock ON supplies(tenant_id) WHERE current_stock < 5 AND is_active = TRUE;